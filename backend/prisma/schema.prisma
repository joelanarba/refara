datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FacilityType {
  CHPS_COMPOUND
  HEALTH_CENTER
  DISTRICT_HOSPITAL
  REGIONAL_HOSPITAL
  TEACHING_HOSPITAL
  PRIVATE_CLINIC
}

enum ReferralUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum Role {
  REFERRING_WORKER
  RECEIVING_WORKER
  ADMIN
}


enum ReferralStatus {
  SUBMITTED
  ACKNOWLEDGED
  ACCEPTED
  REJECTED
  CANCELLED
  PATIENT_ARRIVED
  COMPLETED
}

model Facility {
  id                 String     @id @default(uuid())
  name               String     @unique
  facilityType       FacilityType
  location           String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  users              User[]
  outgoingReferrals  Referral[] @relation("OutgoingFacility")
  incomingReferrals  Referral[] @relation("IncomingFacility")

  @@map("facilities")
}

model User {
  id            String                  @id @default(uuid())
  name          String
  email         String                  @unique
  passwordHash  String
  role          Role
  facilityId    String
  facility      Facility                @relation(fields: [facilityId], references: [id])
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  createdReferrals Referral[]           @relation("ReferralCreator")
  statusAudits     ReferralStatusHistory[]

  @@map("users")
}

model Referral {
  id                  String                  @id @default(uuid())
  referralCode        String                  @unique
  patientName         String
  patientAge          Int
  gestationalAgeWeeks Int
  urgency             ReferralUrgency
  reasonForReferral   String
  currentStatus       ReferralStatus          @default(SUBMITTED)

  referringFacilityId String
  referringFacility   Facility                @relation("OutgoingFacility", fields: [referringFacilityId], references: [id])

  receivingFacilityId String
  receivingFacility   Facility                @relation("IncomingFacility", fields: [receivingFacilityId], references: [id])

  createdByUserId     String
  createdByUser       User                    @relation("ReferralCreator", fields: [createdByUserId], references: [id])

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  statusHistory       ReferralStatusHistory[]

  @@index([referringFacilityId])
  @@index([receivingFacilityId])
  @@index([currentStatus])
  @@map("referrals")
}

model ReferralStatusHistory {
  id             String         @id @default(uuid())
  referralId     String
  referral       Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  previousStatus ReferralStatus
  newStatus      ReferralStatus
  changedByUserId String
  changedByUser  User           @relation(fields: [changedByUserId], references: [id])
  notes          String?
  timestamp      DateTime       @default(now())

  @@index([referralId])
  @@map("referral_status_history")
}